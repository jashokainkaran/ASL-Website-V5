# Set to the approved site origin before public deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Approved HTTPS receiver. Must durably accept the JSON enquiry and respond:
# HTTP 2xx with {"received":true}. A 2xx alone does not indicate receipt.
# No enquiries are sent or reported as received while this is empty.
ASL_ENQUIRY_ENDPOINT=
# Optional receiver authorization; never expose through NEXT_PUBLIC_*.
ASL_ENQUIRY_TOKEN=
